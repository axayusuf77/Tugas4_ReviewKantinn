# Salin jadi .env lalu isi nilainya. Jangan commit .env ke GitHub.

# Server
PORT=3000
# Alamat frontend yang boleh memanggil API ini (pisahkan dengan koma kalau lebih dari satu)
CORS_ORIGIN=http://localhost:5173

# SQL Server
DB_SERVER=localhost
DB_PORT=1433
# Login SQL Server khusus tugas ini
DB_USER=
DB_PASSWORD=
DB_NAME=review_kantin
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Autentikasi JWT
# Isi dengan string acak panjang. Buat dengan:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h
BCRYPT_SALT_ROUNDS=10
